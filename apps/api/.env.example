# Copy to .env for local development. Never commit .env.
ENV=local
DATABASE_URL=postgresql+asyncpg://padhlo:padhlo@localhost:5432/padhlo
REDIS_URL=redis://localhost:6379/0
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-this-is-not-a-real-secret-0000
CORS_ORIGINS=["http://localhost:8080"]
COOKIE_SECURE=false

# AI roadmap generator: disabled | fake (offline canned roadmaps) | anthropic
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=sk-ant-...
