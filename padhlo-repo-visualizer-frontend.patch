+import { useEffect, useState } from "react";
+import type { RepoIndex, TreeNode } from "@/lib/repo-structure";
+import { LangDot } from "./repo-ui";
+
+type Props = {
+  root: TreeNode;
+  index: RepoIndex;
+  selectedFile: string | null;
+  openFolder: string | null;
+  onSelectFile: (path: string) => void;
+  onOpenFolder: (folder: string | null) => void; // null = map of all folders
+};
+
+const ancestors = (path: string) => {
+  const parts = path.split("/");
+  return parts.slice(0, -1).map((_, i) => parts.slice(0, i + 1).join("/"));
+};
+
+export function FolderTree({ root, index, selectedFile, openFolder, onSelectFile, onOpenFolder }: Props) {
+  const [expanded, setExpanded] = useState<Set<string>>(
+    () => new Set(root.children.filter((c) => c.kind === "folder").map((c) => c.path)),
+  );
+
+  // Reveal the selected file in the tree.
+  useEffect(() => {
+    if (!selectedFile) return;
+    setExpanded((prev) => {
+      const next = new Set(prev);
+      ancestors(selectedFile).forEach((a) => next.add(a));
+      return next;
+    });
+  }, [selectedFile]);
+
+  const toggle = (path: string) =>
+    setExpanded((prev) => {
+      const next = new Set(prev);
+      if (next.has(path)) next.delete(path);
+      else next.add(path);
+      return next;
+    });
+
+  function renderNode(node: TreeNode, depth: number) {
+    const pad = { paddingLeft: `${depth * 12 + 4}px` };
+    if (node.kind === "file") {
+      const isSelected = node.path === selectedFile;
+      return (
+        <li key={node.path}>
+          <button
+            type="button"
+            onClick={() => onSelectFile(node.path)}
+            style={pad}
+            className={`flex w-full items-center gap-1.5 rounded py-1 pr-2 text-left text-sm hover:bg-accent ${
+              isSelected ? "bg-accent font-medium" : ""
+            }`}
+            aria-current={isSelected ? "true" : undefined}
+          >
+            <LangDot lang={index.files.get(node.path)?.lang} />
+            <span className="truncate">{node.name}</span>
+            {index.entries.has(node.path) && (
+              <span className="text-xs text-primary" title="Entry point">
+                ▶
+              </span>
+            )}
+            {index.core.has(node.path) && (
+              <span className="text-xs text-muted-foreground" title="Core file">
+                ★
+              </span>
+            )}
+          </button>
+        </li>
+      );
+    }
+    const isOpen = expanded.has(node.path);
+    const meta = index.folders.get(node.path);
+    const isMapped = openFolder === node.path;
+    return (
+      <li key={node.path}>
+        <div style={pad} className={`flex items-start gap-1 rounded pr-2 ${isMapped ? "bg-accent/60" : ""}`}>
+          <button
+            type="button"
+            onClick={() => toggle(node.path)}
+            aria-expanded={isOpen}
+            aria-label={`${isOpen ? "Collapse" : "Expand"} ${node.name}`}
+            className="mt-1 w-4 shrink-0 text-xs text-muted-foreground"
+          >
+            {isOpen ? "▾" : "▸"}
+          </button>
+          <button
+            type="button"
+            onClick={() => {
+              onOpenFolder(node.path);
+              if (!isOpen) toggle(node.path);
+            }}
+            className="min-w-0 flex-1 py-1 text-left hover:underline"
+            title={meta?.summary ?? undefined}
+          >
+            <span className="block truncate text-sm font-medium">{node.name}/</span>
+            {meta?.role && <span className="block truncate text-xs text-muted-foreground">{meta.role}</span>}
+          </button>
+        </div>
+        {isOpen && <ul>{node.children.map((c) => renderNode(c, depth + 1))}</ul>}
+      </li>
+    );
+  }
+
+  return (
+    <nav aria-label="Folders and files" className="rounded-lg border p-2">
+      <div className="flex items-center justify-between px-1 pb-2">
+        <h3 className="text-sm font-medium">Folders</h3>
+        <button
+          type="button"
+          className="text-xs text-muted-foreground hover:underline"
+          onClick={() => onOpenFolder(null)}
+        >
+          map of all folders
+        </button>
+      </div>
+      <ul className="max-h-[70vh] overflow-auto">{root.children.map((c) => renderNode(c, 0))}</ul>
+      <p className="px-1 pt-2 text-xs text-muted-foreground">▶ entry point · ★ core file</p>
+    </nav>
+  );
+}
diff --git a/apps/web/src/components/repos/RepoExplorer.tsx b/apps/web/src/components/repos/RepoExplorer.tsx
new file mode 100644
index 0000000..716169e
--- /dev/null
+++ b/apps/web/src/components/repos/RepoExplorer.tsx
@@ -0,0 +1,153 @@
+import { useMemo, useRef, useState, type FormEvent } from "react";
+import { useMutation, useQuery } from "@tanstack/react-query";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { analyzeRepo, getRepo, getRepoStructure, type RepoStructure } from "@/lib/repos-api";
+import { buildIndex, buildTree, dirOf } from "@/lib/repo-structure";
+import { DependencyMap, SMALL_REPO_FILES } from "./DependencyMap";
+import { FilePanel } from "./FilePanel";
+import { FolderTree } from "./FolderTree";
+import { RepoOverview } from "./RepoOverview";
+
+const BUSY = new Set(["pending", "syncing"]);
+
+export function RepoExplorer() {
+  const [url, setUrl] = useState("");
+  const [repoId, setRepoId] = useState<string | null>(null);
+
+  const analyze = useMutation({ mutationFn: analyzeRepo, onSuccess: (repo) => setRepoId(repo.id) });
+
+  const status = useQuery({
+    queryKey: ["repo", repoId],
+    queryFn: () => getRepo(repoId!),
+    enabled: !!repoId,
+    refetchInterval: (q) => (q.state.data && BUSY.has(q.state.data.sync_status) ? 2000 : false),
+  });
+
+  const ready = status.data?.sync_status === "ok";
+  const structure = useQuery({
+    queryKey: ["repo-structure", repoId, status.data?.commit_sha],
+    queryFn: () => getRepoStructure(repoId!),
+    enabled: !!repoId && ready,
+    staleTime: 10 * 60 * 1000,
+  });
+
+  const busy = analyze.isPending || (!!status.data && BUSY.has(status.data.sync_status));
+
+  function onSubmit(e: FormEvent) {
+    e.preventDefault();
+    if (url.trim()) analyze.mutate(url.trim());
+  }
+
+  return (
+    <div className="space-y-6">
+      <form onSubmit={onSubmit} className="flex flex-col gap-2 sm:flex-row">
+        <Input
+          value={url}
+          onChange={(e) => setUrl(e.target.value)}
+          placeholder="https://github.com/owner/repo"
+          aria-label="GitHub repository URL"
+        />
+        <Button type="submit" disabled={busy}>
+          {busy ? "Analyzing…" : "Explore repository"}
+        </Button>
+      </form>
+      <p className="text-xs text-muted-foreground">
+        Works with public repositories. Python, JavaScript and TypeScript code is analyzed.
+      </p>
+
+      {analyze.isError && <p className="text-sm text-destructive">{analyze.error.message}</p>}
+      {status.data && BUSY.has(status.data.sync_status) && (
+        <p className="text-sm text-muted-foreground" aria-live="polite">
+          Reading the code of {status.data.full_name}. Bigger projects take up to a minute.
+        </p>
+      )}
+      {status.data?.sync_status === "failed" && <p className="text-sm text-destructive">{status.data.sync_error}</p>}
+      {structure.isError && <p className="text-sm text-destructive">{structure.error.message}</p>}
+      {ready && structure.isPending && <p className="text-sm text-muted-foreground">Loading the map…</p>}
+
+      {structure.data && <Workspace key={structure.data.repo.id} structure={structure.data} />}
+    </div>
+  );
+}
+
+function Workspace({ structure }: { structure: RepoStructure }) {
+  const { repo, analysis } = structure;
+  const index = useMemo(() => buildIndex(analysis), [analysis]);
+  const tree = useMemo(() => buildTree(analysis.files.map((f) => f.path)), [analysis]);
+  const small = analysis.files.length <= SMALL_REPO_FILES;
+
+  const [folder, setFolder] = useState<string | null>(null);
+  const [selectedFile, setSelectedFile] = useState<string | null>(null);
+  const [selectedSymbol, setSelectedSymbol] = useState<string | null>(null);
+  const panelRef = useRef<HTMLDivElement>(null);
+
+  function selectFile(path: string, symbolId: string | null = null) {
+    setSelectedFile(path);
+    setSelectedSymbol(symbolId);
+    if (!small) setFolder(dirOf(path));
+    // Bring the file panel into view if it's below the fold.
+    requestAnimationFrame(() => {
+      const el = panelRef.current;
+      if (el && el.getBoundingClientRect().top > window.innerHeight * 0.75) {
+        el.scrollIntoView({ behavior: "smooth", block: "start" });
+      }
+    });
+  }
+
+  if (analysis.files.length === 0) {
+    return (
+      <div className="space-y-4">
+        <RepoOverview repo={repo} analysis={analysis} onSelectFile={selectFile} />
+        <p className="text-sm text-muted-foreground">
+          No Python, JavaScript or TypeScript files were found in this repository.
+        </p>
+      </div>
+    );
+  }
+
+  const file = selectedFile ? index.files.get(selectedFile) : undefined;
+
+  return (
+    <div className="space-y-6">
+      <RepoOverview repo={repo} analysis={analysis} onSelectFile={selectFile} />
+      <div className="grid gap-4 lg:grid-cols-[260px_minmax(0,1fr)]">
+        <FolderTree
+          root={tree}
+          index={index}
+          selectedFile={selectedFile}
+          openFolder={folder}
+          onSelectFile={selectFile}
+          onOpenFolder={setFolder}
+        />
+        <div className="min-w-0 space-y-4">
+          <DependencyMap
+            analysis={analysis}
+            index={index}
+            folder={folder}
+            selectedFile={selectedFile}
+            onOpenFolder={setFolder}
+            onSelectFile={selectFile}
+          />
+          <div ref={panelRef} className="scroll-mt-4">
+            {file ? (
+              <FilePanel
+                repo={repo}
+                file={file}
+                index={index}
+                selectedSymbol={selectedSymbol}
+                onSelectFile={selectFile}
+                onSelectSymbol={setSelectedSymbol}
+              />
+            ) : (
+              <p className="rounded-lg border border-dashed p-6 text-center text-sm text-muted-foreground">
+                Pick a file in the map, the folder list or the reading order to see what it does, what it uses
+                and how its functions call each other.
+              </p>
+            )}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/components/repos/RepoOverview.tsx b/apps/web/src/components/repos/RepoOverview.tsx
